# Environment variables for Deep Thought API
# Copy this file to .env and fill in your values

# Your Solana wallet address to receive payments (Required)
RESOURCE_WALLET_ADDRESS=""

# Kobaru facilitator URL (Optional - defaults to https://gateway.kobaru.io)
FACILITATOR_URL="https://gateway.kobaru.io"

# Port for Node.js/Docker deployments (Optional - defaults to 3000)
PORT=3000
