# x402 Wallet Addresses
# You must configure at least one of these to receive payments
# EVM Compatible (SKALE, etc.)
SKALE_WALLET_ADDRESS=
SKALE_NETWORK_ID=eip155:324705682
SKALE_ASSET_ADDRESS=0x2e08028E3C4c2356572E096d8EF835cD5C6030bD

# Payment Facilitator (Gateway to the blockchain)
FACILITATOR_URL=https://gateway.kobaru.io

# Google Gemini API Key for Vercel AI SDK
GOOGLE_GENERATIVE_AI_API_KEY=

# Server Port
PORT=3000

# SQLite Database Path (Optional, defaults to ./socratic.db)
DB_PATH=socratic.db
