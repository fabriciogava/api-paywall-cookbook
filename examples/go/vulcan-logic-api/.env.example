# Vulcan Logic API - Environment Variables

# REQUIRED: Your Base wallet address to receive payments
BASE_WALLET_ADDRESS=

# REQUIRED: Google AI Studio API key for Gemini
GEMINI_API_KEY=

# OPTIONAL: Facilitator URL (defaults to Kobaru gateway)
# FACILITATOR_URL=https://gateway.kobaru.io

# OPTIONAL: Server port (defaults to 3000)
# PORT=3000
