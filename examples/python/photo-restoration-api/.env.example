# Photo Restoration API - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED: Blockchain Wallet Configuration
# ============================================================================

# Your SKALE wallet address (Ethereum format: 0x...)
# This is where you'll receive USDC payments
# You can use any Ethereum wallet (MetaMask, Coinbase Wallet, etc.)
SKALE_WALLET_ADDRESS=

# ============================================================================
# REQUIRED: AI Service Configuration
# ============================================================================

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
# Used for AI-powered photo restoration analysis
GEMINI_API_KEY=

# ============================================================================
# OPTIONAL: Payment Facilitator Configuration
# ============================================================================

# Kobaru Gateway URL (x402 facilitator)
# Default: https://gateway.kobaru.io
# Only change if using a different facilitator
FACILITATOR_URL=https://gateway.kobaru.io

# Kobaru API Key (optional)
# Get yours at: https://kobaru.io
# Enables premium features like advanced analytics and priority support
KOBARU_API_KEY=

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================

# HTTP server port
# Default: 3000
PORT=3000

# Price per photo restoration
# Default: $0.10
# Format: Dollar amount with $ prefix (e.g., $0.05, $1.00, $0.50)
RESTORATION_PRICE=$0.10

# ============================================================================
# OPTIONAL: Network Configuration (SKALE recommended)
# ============================================================================
#
# Token metadata (name, version, decimals) is fetched automatically from
# the Kobaru facilitator - no need to configure those values manually.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ SKALE MAINNET (default - recommended for production)                    │
# │   NETWORK_ID=eip155:1187947933                                          │
# │   ASSET_ADDRESS=0x85889c8c714505E0c94b30fcfcF64fE3Ac8FCb20               │
# ├─────────────────────────────────────────────────────────────────────────┤
# │ SKALE DEVNET (for testing)                                              │
# │   NETWORK_ID=eip155:324705682                                           │
# │   ASSET_ADDRESS=0x2e08028E3C4c2356572E096d8EF835cD5C6030bD               │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Other supported networks:
#   Base Mainnet:   eip155:8453       / 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Base Sepolia:   eip155:84532      / 0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Blockchain Network ID (CAIP-2 format)
NETWORK_ID=eip155:1187947933

# USDC Token Address on the selected network
ASSET_ADDRESS=0x85889c8c714505E0c94b30fcfcF64fE3Ac8FCb20

# ============================================================================
# Testing Information
# ============================================================================
#
# To test payments:
# 1. Configure network and asset above
# 2. Ensure your wallet has USDC on the selected network
# 3. Use the 007-test-agent: cd tools/007-test-agent && npm start
