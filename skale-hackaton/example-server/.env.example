# Your SKALE wallet address to receive payments (REQUIRED)
# This is where you'll receive USDC payments from API consumers
SKALE_WALLET_ADDRESS=""

# Kobaru API Key (OPTIONAL - for authenticated facilitator requests)
# Generate this at: https://console.kobaru.io
# Benefits: Access to console logs, metrics, and enhanced features
KOBARU_API_KEY=""

# Kobaru facilitator URL (Optional - defaults to https://gateway.kobaru.io)
# The facilitator handles payment verification so you don't need to run a blockchain node
FACILITATOR_URL="https://gateway.kobaru.io"

# Port for Node.js/Docker deployments (Optional - defaults to 3000)
PORT=3000

