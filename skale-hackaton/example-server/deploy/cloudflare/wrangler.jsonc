{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "deep-thought-api",
    "main": "index.ts",
    "compatibility_date": "2026-01-05",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "vars": {
        "FACILITATOR_URL": "https://gateway.kobaru.io"
    }
  // Secrets are not stored in this file!
  //
  // SOLANA_WALLET_ADDRESS / BASE_WALLET_ADDRESS should be set as secrets:
  // npx wrangler secret put SOLANA_WALLET_ADDRESS
  // npx wrangler secret put BASE_WALLET_ADDRESS
  //
  // FACILITATOR_URL is optional (defaults to Kobaru public instance)
}